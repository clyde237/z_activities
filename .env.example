FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-development
DATABASE_PATH=instance/app.sqlite3
# SQLALCHEMY_DATABASE_URI peut être définie directement pour pointer vers
# PostgreSQL en production (ex: postgresql://user:pass@host/dbname).
# Non renseignée, elle est déduite de DATABASE_PATH (SQLite local).
